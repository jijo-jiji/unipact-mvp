# UniPact backend configuration
# Copy to .env for local overrides. On the server, set these as environment variables in your
# hosting dashboard instead (never commit a real .env file).
#
# Local development needs NONE of these: without them you get DEBUG, SQLite and local file storage.

# --- Environment --------------------------------------------------
# "production" switches on HTTPS redirects, secure cookies, HSTS and required-setting checks
DJANGO_ENV=production
DJANGO_DEBUG=false

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Domain(s) the API is served from, comma separated
DJANGO_ALLOWED_HOSTS=api.unipact.my

# Hide the Django admin behind an unguessable path (keep the trailing slash)
DJANGO_ADMIN_URL=ops-change-me/

# --- Frontend access (CORS / cookies) -----------------------------
# The website address(es) allowed to call the API
CORS_ALLOWED_ORIGINS=https://unipact.my,https://www.unipact.my
CSRF_TRUSTED_ORIGINS=https://unipact.my,https://www.unipact.my

# Host the site and API on the same domain family (unipact.my + api.unipact.my) and keep Lax.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=true
# Share login cookies between unipact.my and api.unipact.my
AUTH_COOKIE_DOMAIN=.unipact.my

# --- Database -----------------------------------------------------
# PostgreSQL connection string from Render / Railway / Neon / Supabase
DATABASE_URL=postgres://user:password@host:5432/unipact
DATABASE_SSL_REQUIRE=true

# --- Uploaded files (Cloudflare R2, AWS S3, DigitalOcean Spaces) ---
USE_S3=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=unipact-uploads
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# How long private download links stay valid, in seconds
AWS_QUERYSTRING_EXPIRE=3600

# Upload size limits in MB
MAX_DOCUMENT_UPLOAD_MB=10
MAX_PROJECT_FILE_UPLOAD_MB=500

# --- Rate limits (per IP for login/register) ----------------------
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=20/hour
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
# Set when running more than one server process so limits are shared (also add "redis" to requirements)
# REDIS_URL=redis://localhost:6379/0
# Number of proxies/load balancers in front of Django (Render, Railway, Nginx = 1)
NUM_PROXIES=1

LOG_LEVEL=INFO
