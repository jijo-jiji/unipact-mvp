# UniPact frontend configuration (Vite reads variables starting with VITE_ at build time)
# Local development needs nothing: the app talks to http://localhost:8000/api automatically.

# Production: the public address of the Django API, including /api
VITE_API_BASE_URL=https://api.unipact.my/api

# Public website address (no trailing slash). Used for link previews (WhatsApp/LinkedIn), sitemap.xml and robots.txt
VITE_SITE_URL=https://unipact.my

# --- Legal pages (Privacy Policy & Terms) ---------------------------
# Shown on /privacy, /terms and the footer. Bracketed placeholders appear until these are set.
# Copy the name, number and address exactly as they appear on the SSM registration certificate.
VITE_LEGAL_ENTITY_NAME=Your Company Sdn. Bhd.
VITE_LEGAL_REGISTRATION_NO=your SSM registration number
VITE_LEGAL_ADDRESS=your registered business address
VITE_CONTACT_EMAIL=privacy@your-domain.my
VITE_LEGAL_LAST_UPDATED=15 September 2026

# --- Error monitoring (Sentry) --------------------------------------
# Leave empty to disable. Use a separate Sentry project from the backend.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0
